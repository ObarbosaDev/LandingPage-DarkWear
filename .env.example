# Copie para .env.local (desenvolvimento) ou configure no painel da Vercel (produção).

# Senha do painel do dono (/admin). Use uma frase longa e única.
ADMIN_PASSWORD=

# Segredo para assinar a sessão do painel. Mínimo de 32 caracteres aleatórios.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Postgres de produção (Neon). Na Vercel, o Marketplace injeta esta variável.
# Sem ela, em desenvolvimento, o projeto usa um Postgres embutido em .data/.
DATABASE_URL=

# Segredo do cron diário que cancela pedidos pendentes antigos e devolve as peças ao estoque.
# Na Vercel, o cron envia este valor sozinho. Sem ele, a rota /api/cron/expire-orders fica fechada.
CRON_SECRET=

# Opcional. Horas até um pedido pendente expirar (padrão: 48).
PENDING_ORDER_HOURS=

# Endereço público do site, usado no sitemap e no robots. Ex.: https://seusite.com.br
SITE_URL=

# Opcional. Com "false", o servidor NÃO aplica migrações ao subir: só confere se o banco está em dia.
# Use em produção com publicação controlada e rode "npm run db:migrate" antes de cada versão nova.
# Padrão (vazio ou "true"): o servidor aplica as migrações pendentes sozinho.
DB_AUTO_MIGRATE=
