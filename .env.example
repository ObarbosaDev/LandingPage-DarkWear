# Copie para .env.local (desenvolvimento) ou configure no painel da Vercel (produção).

# O painel do dono NÃO tem senha própria: quem administra é uma conta com papel "admin", criada pelo comando
#   npm run admin:criar -- --email EMAIL --nome "NOME" --celular DDDNUMERO
# (veja o README). As antigas ADMIN_PASSWORD e ADMIN_SESSION_SECRET não são mais usadas.

# Segredo para assinar a sessão (cadastro e login de clientes e administradores). Obrigatório: sem ele ninguém
# consegue entrar nem comprar. Mínimo de 32 caracteres aleatórios.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Trocar este valor desconecta todos os clientes de uma vez.
CUSTOMER_SESSION_SECRET=

# Postgres de produção (Neon). Na Vercel, o Marketplace injeta esta variável.
# Sem ela, em desenvolvimento, o projeto usa um Postgres embutido em .data/.
DATABASE_URL=

# Segredo do cron diário que cancela pedidos pendentes antigos e devolve as peças ao estoque.
# Na Vercel, o cron envia este valor sozinho. Sem ele, a rota /api/cron/expire-orders fica fechada.
CRON_SECRET=

# Opcional. Horas até um pedido pendente combinado pelo WhatsApp expirar (padrão: 48).
# Pedidos com cobrança online (Mercado Pago) expiram em 12 horas, junto com a validade da cobrança.
PENDING_ORDER_HOURS=

# Endereço público do site, usado no sitemap e no robots. Ex.: https://seusite.com.br
SITE_URL=

# Opcional. Com "false", o servidor NÃO aplica migrações ao subir: só confere se o banco está em dia.
# Use em produção com publicação controlada e rode "npm run db:migrate" antes de cada versão nova.
# Padrão (vazio ou "true"): o servidor aplica as migrações pendentes sozinho.
DB_AUTO_MIGRATE=

# ---- Pagamento online (Mercado Pago) ----------------------------------------
# Opcional. Sem MERCADOPAGO_ACCESS_TOKEN o site fecha pedidos só pelo WhatsApp.
# Crie a conta e a aplicação em https://www.mercadopago.com.br/developers e copie as credenciais.
# O cartão é digitado na página do Mercado Pago: nunca passa por este site.
MERCADOPAGO_ACCESS_TOKEN=

# Assinatura secreta dos avisos (Suas integrações > Webhooks). Sem ela, os avisos não têm a assinatura conferida.
# O endereço a cadastrar lá é: <SITE_URL>/api/webhooks/mercadopago  (evento "Pagamentos")
MERCADOPAGO_WEBHOOK_SECRET=

# Opcional. Máximo de parcelas no cartão, de 1 a 12 (padrão 1, à vista). Parcelar tem custo para a loja.
MERCADOPAGO_MAX_INSTALLMENTS=

# Opcional. "true" usa a página de teste do Mercado Pago (use com as credenciais de TESTE).
MERCADOPAGO_SANDBOX=
